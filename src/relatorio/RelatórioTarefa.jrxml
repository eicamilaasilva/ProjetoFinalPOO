	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<queryString language="SQL">
		<![CDATA[SELECT
    T.id_tarefa,
    T.titulo,
    T.descricao,
    T.data_entrega,
    T.status,
    T.prioridade,
    M.nome AS materia

FROM Tarefa T

INNER JOIN Materia M
    ON T.id_materia = M.id_materia

ORDER BY
    T.data_entrega ASC,
    M.nome ASC]]>
	</queryString>
