<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RelatórioDesempenho" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8f4750a4-3578-4f36-8b21-2dc2f4ed232f">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Focusup.jrdax"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    M.id_materia,
    M.nome AS materia,

    COUNT(A.id_avaliacao) AS total_avaliacoes,

    COUNT(A.nota) AS avaliacoes_corrigidas,

    COALESCE(
        SUM(
            CASE
                WHEN A.nota IS NOT NULL THEN A.nota
                ELSE 0
            END
        ), 0
    ) AS pontos_obtidos,

    COALESCE(
        SUM(
            CASE
                WHEN A.nota IS NOT NULL THEN A.valor_maximo
                ELSE 0
            END
        ), 0
    ) AS pontos_possiveis,

    CASE
        WHEN SUM(
            CASE
                WHEN A.nota IS NOT NULL THEN A.valor_maximo
                ELSE 0
            END
        ) = 0
        THEN NULL

        ELSE ROUND(
            100 * SUM(
                CASE
                    WHEN A.nota IS NOT NULL THEN A.nota
                    ELSE 0
                END
            )
            /
            SUM(
                CASE
                    WHEN A.nota IS NOT NULL THEN A.valor_maximo
                    ELSE 0
                END
            ),
            2
        )
    END AS percentual_desempenho

FROM Materia M

LEFT JOIN Avaliacao A
    ON M.id_materia = A.id_materia

GROUP BY
    M.id_materia,
    M.nome

ORDER BY
    M.nome ASC;]]>
	</queryString>
