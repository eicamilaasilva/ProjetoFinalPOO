<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tela responsável pela apresentação
    da página inicial do sistema FocusUp.

    @author Emanuelle
    @version 2.0
-->

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    prefHeight="640.0"
    prefWidth="400.0"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="controller.MainController">

    <children>

        <MenuBar VBox.vgrow="NEVER">

            <menus>

                <!-- Menu Página Inicial -->
                <Menu mnemonicParsing="false" text="Página inicial">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/logo_focusup.jpeg"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="Home"
                            mnemonicParsing="false"
                            onAction="#home"
                            text="Home">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/logo_focusup.jpeg"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                        <MenuItem
    					fx:id="fechar"
    					mnemonicParsing="false"
    					onAction="#fechar"
    					text="Fechar">

    					<graphic>
        					<ImageView
            					fitHeight="16.0"
            					fitWidth="16.0"
            					preserveRatio="true">

            			<image>
                			<Image url="@../imagens/icons8-cancel-16.png"/>
            			</image>

        			</ImageView>
    			</graphic>

</MenuItem>

                    </items>

                </Menu>

                <!-- Menu Matérias -->
                <Menu
                    mnemonicParsing="false"
                    onAction="#materias"
                    text="Matérias">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/icons8-materias-16.png"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="CadastrosLivros"
                            mnemonicParsing="false"
                            onAction="#materias"
                            text="Matérias">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/icons8-materias-16.png"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                    </items>

                </Menu>

                <!-- Menu Tarefas -->
                <Menu
                    mnemonicParsing="false"
                    onAction="#tarefas"
                    text="Tarefa">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/icons8-tarefa-16.png"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="RelatorioLivros"
                            mnemonicParsing="false"
                            onAction="#tarefas"
                            text="Tarefa">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/icons8-tarefa-16.png"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                    </items>

                </Menu>

                <!-- Menu Avaliações -->
                <Menu
                    mnemonicParsing="false"
                    onAction="#avaliacoes"
                    text="Avaliações">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/icons8-avaliacao-nota-16.png"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="sobre"
                            mnemonicParsing="false"
                            onAction="#avaliacoes"
                            text="Avaliações">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/icons8-avaliacao-nota-16.png"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                    </items>

                </Menu>

                <!-- Menu Relatório de Tarefas -->
                <Menu
                    mnemonicParsing="false"
                    text="Relatório de Tarefas">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/icons8-pendentes-16.png"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="RelatorioLivros1"
                            mnemonicParsing="false"
                            onAction="#relatorios"
                            text="Relatório de Tarefas">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/icons8-pendentes-16.png"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                    </items>

                </Menu>

                <!-- Menu Relatório de Desempenho -->
                <Menu
                    mnemonicParsing="false"
                    text="Relatório de Desempenho">

                    <graphic>
                        <ImageView
                            fitHeight="16.0"
                            fitWidth="16.0"
                            preserveRatio="true">
                            <image>
                                <Image url="@../imagens/icons8-avaliacao-nota-16.png"/>
                            </image>
                        </ImageView>
                    </graphic>

                    <items>

                        <MenuItem
                            fx:id="RelatorioLivros11"
                            mnemonicParsing="false"
                            onAction="#relatorioD"
                            text="Relatório de Desempenho">

                            <graphic>
                                <ImageView
                                    fitHeight="16.0"
                                    fitWidth="16.0"
                                    preserveRatio="true">
                                    <image>
                                        <Image url="@../imagens/icons8-avaliacao-nota-16.png"/>
                                    </image>
                                </ImageView>
                            </graphic>

                        </MenuItem>

                    </items>

                </Menu>

                <!-- Menu Ajuda -->
                <Menu
                    mnemonicParsing="false"
                    text="Ajuda">

                    <items>

                        <MenuItem
                            fx:id="RelatorioLivros111"
                            mnemonicParsing="false"
                            onAction="#ajuda"
                            text="Ajuda"/>

                    </items>

                </Menu>

            </menus>

        </MenuBar>

        <!-- Área principal da aplicação -->
        <AnchorPane
            fx:id="Principal"
            maxHeight="-1.0"
            maxWidth="-1.0"
            prefHeight="191.0"
            prefWidth="305.0"
            VBox.vgrow="ALWAYS">

            <children>

                <AnchorPane
                    fx:id="root"
                    layoutX="2.0"
                    layoutY="6.0"
                    prefHeight="364.0"
                    prefWidth="634.0"/>

            </children>

        </AnchorPane>

    </children>

</VBox>