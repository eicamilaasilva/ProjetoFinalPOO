<?xml version="1.0" encoding="UTF-8"?>
<!--
    Tela responsável pelo cadastro
    das Avaliações.

    @author Emanuelle
    @version 2.0
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AvaliacaoController">

    <padding>
        <Insets bottom="15.0" left="15.0"
                right="15.0" top="15.0"/>
    </padding>

    <top>
        <VBox spacing="10.0">

            <GridPane hgap="10.0" vgap="10.0">

                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER" minWidth="130.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <children>

                    <!-- Título -->
                    <Label text="Título da Avaliação:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="0"/>

                    <TextField fx:id="titulo"
                               promptText="Digite o título"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="0"/>

                    <!-- Matéria -->
                    <Label text="Matéria Vinculada:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="1"/>

                    <ComboBox fx:id="materia"
                              maxWidth="Infinity"
                              promptText="Selecione a matéria"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1"/>

                    <!-- Nota -->
                    <Label text="Nota:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="2"/>

                    <TextField fx:id="nota"
                               promptText="Nota obtida"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="2"/>

                    <!-- Data -->
                    <Label text="Data da Avaliação:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="3"/>

                    <DatePicker fx:id="data"
                                maxWidth="Infinity"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="3"/>

                    <!-- Valor máximo -->
                    <Label text="Valor Máximo:"
                           GridPane.columnIndex="0"
                           GridPane.rowIndex="4"/>

                    <TextField fx:id="maximo"
                               text="10"
                               promptText="Valor máximo da avaliação"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="4"/>

                </children>

            </GridPane>

            <!-- Botões -->
            <HBox spacing="10.0">

                <padding>
                    <Insets bottom="10.0" top="5.0"/>
                </padding>

                <children>

                    <Button onAction="#salvar"
                            text="Salvar Avaliação">

                        <graphic>
                            <ImageView fitHeight="16.0"
                                       fitWidth="16.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">
                                <image>
                                    <Image url="@../imagens/icons8-save-16.png"/>
                                </image>
                            </ImageView>
                        </graphic>

                    </Button>

                    <Button onAction="#excluir"
                            style="-fx-background-color: #ffcccc;"
                            text="Excluir">

                        <graphic>
                            <ImageView fitHeight="16.0"
                                       fitWidth="16.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">
                                <image>
                                    <Image url="@../imagens/icons8-delete-16.png"/>
                                </image>
                            </ImageView>
                        </graphic>

                    </Button>

                    <Button onAction="#novo"
                            text="Novo">

                        <graphic>
                            <ImageView fitHeight="16.0"
                                       fitWidth="16.0"
                                       pickOnBounds="true"
                                       preserveRatio="true">
                                <image>
                                    <Image url="@../imagens/icons8-cancel-16.png"/>
                                </image>
                            </ImageView>
                        </graphic>

                    </Button>

                </children>

            </HBox>

        </VBox>
    </top>

    <!-- Tabela de avaliações -->
    <center>

        <TableView fx:id="tabela">

            <columns>

                <TableColumn fx:id="cMateria"
                             prefWidth="144.0"
                             text="Matéria"/>

                <TableColumn fx:id="cTitulo"
                             prefWidth="201.6"
                             text="Título"/>

                <TableColumn fx:id="cNota"
                             prefWidth="110.0"
                             text="Nota"/>

                <TableColumn fx:id="cData"
                             prefWidth="93.6"
                             text="Data"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </center>

</BorderPane>